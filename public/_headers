# HTML and story updates revalidate; the service worker warms versioned resources.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

# Vite-generated assets include content hashes in their filenames.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# Allow short browser reuse even before the service worker takes control.
/*.jpg
  Cache-Control: public, max-age=3600

/*.png
  Cache-Control: public, max-age=3600

/*.webp
  Cache-Control: public, max-age=3600
